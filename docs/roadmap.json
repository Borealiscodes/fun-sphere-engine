      "description": "Expand the engine with runtime, world topology, reversible quests, and documentation.",
      "files": [
        "world/topology.json",
        "world/zones.py",
        "world/factions.py",
        "world/monsters.py",
        "runtime/server.py",
        "runtime/client.py",
        "quests/reversible.py",
        "ui/glyphs.md",
        "docs/architecture.md",
        "docs/provenance.md",
        "README.md"
      ],
      "invariants": [
        "consume Phase-A physics",
        "do not modify Phase-A physics",
        "modular world logic",
        "holonomy semantics preserved",
        "operator reversibility preserved"
      ]
    }
  }
}
